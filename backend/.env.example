# ── Server ─────────────────────────────────────────────────────────────────
# ENV=production disables auto-reload and enables multi-worker mode in run.sh
ENV=dev
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Scan limits ─────────────────────────────────────────────────────────────
# Max scans running at once (requests beyond this get HTTP 429)
MAX_CONCURRENT_SCANS=3
# Hard timeout for a full scan / exam analysis pipeline (seconds)
SCAN_TIMEOUT_SECS=600
ANALYSIS_TIMEOUT_SECS=300
# Finished scans/sessions are purged from memory after this many seconds
SESSION_TTL_SECS=86400
# Set to true ONLY for lab/demo use — allows scanning localhost/private IPs
ALLOW_PRIVATE_TARGETS=false

# ── Data retention ──────────────────────────────────────────────────────────
# A scan report is not one object: its row lives in scan_history.json, its
# findings can be offloaded to a cold archive, and a repo scan also leaves a
# clone on disk. The lifecycle below moves a scan through those stores and
# reports, per store, whether the work completed.
#
# Thresholds are in days and measured from the scan date. Lower them to walk
# the whole lifecycle in a demo without waiting a quarter.
RETENTION_ARCHIVE_AFTER_DAYS=30
RETENTION_TRASH_AFTER_DAYS=90
# Days a scan sits in the trash before the sweep may purge it
RETENTION_PURGE_AFTER_DAYS=14
# What an unqualified purge does. "payload" erases the findings, patches and
# executive summary but keeps the score row so a site's risk trend stays
# continuous; "full" removes the row as well.
RETENTION_PURGE_MODE=payload
# Where offloaded findings and the append-only audit ledger live
RETENTION_ARCHIVE_DIR=retention_archive
RETENTION_AUDIT_FILE=retention_audit.jsonl

# ── Port scanning authorisation ───────────────────────────────────────────
# HTTP checks run against any target: reading a site's headers is what a
# browser does. Connecting to 25 of its ports is not, and against a host you
# do not control it is unauthorised testing. So the port scan runs only
# against hosts listed here, and nothing is listed by default.
#
# Comma separated. Exact match, with "*." for subdomains:
#   AUTHORISED_SCAN_TARGETS=staging.example.com,*.internal.example.com
# "*.example.com" covers api.example.com but not example.com itself.
#
# Loopback and private addresses count as authorised when
# ALLOW_PRIVATE_TARGETS is on, since that already means "my own machine".
AUTHORISED_SCAN_TARGETS=

# ── Groq (primary LLM — fast cloud inference) ─────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
#
# Multiple keys rotate on auth failure (comma-separated, no spaces needed):
# GROQ_API_KEYS=gsk_aaa,gsk_bbb
#
# Ordered model list (first healthy model wins). Verified 2026-10-09:
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Single pin (overrides GROQ_MODELS; a pinned retired id raises naming itself):
# GROQ_MODEL=openai/gpt-oss-20b
#
# Groq retires models on a published schedule, and a retired id stops serving
# traffic rather than degrading: it returns 400 and every scan fails. Both
# llama-3.1-8b-instant and llama-3.3-70b-versatile were shut down on
# 2026-08-16, and the second of those used to be the value suggested here.
# Check https://console.groq.com/docs/deprecations before a deployment.
#
# Leave GROQ_MODEL unset to take the code's current default, which is the one
# place this is kept up to date. Setting it here overrides that default, so a
# stale value in a deployment's environment survives an upgrade.
# GROQ_MODEL=openai/gpt-oss-20b

# ── Ollama (offline / low-spec fallback) ──────────────────────────────────
# Install: https://ollama.com/download
# Ollama runs automatically on port 11434 — no extra config needed.
OLLAMA_BASE_URL=http://localhost:11434

# System-aware model routing (auto-detected — no action required)
# The router detects RAM / CPU cores / GPU and selects a model automatically:
#   low  spec (RAM < 8 GB  OR cores < 4)  → phi3:mini   (~2.3 GB)
#   mid  spec (RAM 8-16 GB AND cores 4+)  → llama3.2    (~2 GB)
#   high spec (RAM >= 16 GB AND cores 8+) → llama3.1:8b (~5 GB)
#
# Override the model for a specific tier:
OLLAMA_MODEL_LOW=phi3:mini
OLLAMA_MODEL_MID=llama3.2
OLLAMA_MODEL_HIGH=llama3.1:8b
#
# Override ALL tiers (backward-compatible, takes highest precedence):
# OLLAMA_MODEL=llama3.2
#
# Force a spec tier (skip hardware detection):
# SYSTEM_SPEC_OVERRIDE=low
#
# Simulate hardware for testing:
# SYSTEM_RAM_GB=4
# SYSTEM_CPU_CORES=2
# SYSTEM_HAS_GPU=false

# ── Gemini (second provider, OpenAI-compatible endpoint) ──────────────────
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# Verified 2026-10-09 (gemini-2.5-* is 404 for new users, *-pro is 429 with
# no free quota — both auto-disabled, not retried):
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.5-flash

# ── OpenRouter (third provider, free tier — 50 free reqs/day) ───────────────
# Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# Verified 2026-10-09 (upstream 429s skip immediately, budget < 5 disables):
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free

# ── Multi-provider pool + fix loop (prompt 00a) ─────────────────────────────
# Per-provider concurrent calls (pool spreads prompts across providers):
# LLM_CONCURRENCY_GROQ=4
# LLM_CONCURRENCY_GEMINI=2
# LLM_CONCURRENCY_OPENROUTER=1
# LLM_CONCURRENCY_OLLAMA=2
# Per-call ceiling so one hung provider cannot wedge a pool worker:
# LLM_TIMEOUT_SECS=120
# Retry escalation: attempt 1 fast → attempt 2 strong → attempt 3+ fresh eye:
# GROQ_FAST_MODEL=qwen/qwen3.8-27b
# GROQ_STRONG_MODEL=openai/gpt-oss-120b
# ESCALATION_MODEL_3=gemini-3-flash-preview
# Multi-vulnerability fix loop (secure_coder/reviewer/tester consume these):
# MAX_FIX_TARGETS=3
# PARALLEL_FIX_WORKERS=2
# MAX_FIX_ATTEMPTS=3

# ── OSIRIS OSINT enrichment ───────────────────────────────────────────────
# Pivots a finding into third-party intelligence about the address it was
# found on: geolocation, ASN and network owner, reputation, and the services
# and known vulnerabilities visible from outside. Keyless — nothing to sign up
# for. Only the passive OSIRIS routes are used; its active scanner and sweep
# routes generate traffic against a target and are deliberately left alone.
#
# Lookups happen on demand. Nothing reaches osirisai.live until an analyst
# opens the panel on a specific finding, and only public addresses are sent:
# a loopback or RFC 1918 address describes the machine that ran the scan and
# is refused before any request is made.
#
# Set to false to take the integration out of the product entirely — the API
# refuses the lookup and the UI stops offering it.
# OSIRIS_ENABLED=false
#
# Point at your own instance instead of the hosted one. OSIRIS is MIT-licensed
# and self-hosts in three commands (github.com/simplifaisoul/osiris), which is
# the right call if scan targets must not leave your network.
# OSIRIS_URL=http://localhost:3000
#
# Seconds to wait on any single OSIRIS route before treating it as unavailable.
# OSIRIS_TIMEOUT=8
