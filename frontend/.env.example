# Frontend → backend wiring. On Vercel, set these in
# Project Settings → Environment Variables (Production).
#
# Point both at your deployed Render backend. Use https:// for the API
# and wss:// for the WebSocket (same host).
#
# Copy the host from the Render dashboard rather than assuming it matches the
# service name: if the hostname is already taken, Render appends a random
# suffix, so the service "sentinelai-backend" can be served from
# sentinelai-backend-xxxx.onrender.com.

NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com

# Local development defaults (no .env needed locally):
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   NEXT_PUBLIC_WS_URL=ws://localhost:8000
#
# BUILD-TIME NOTE: Next.js inlines NEXT_PUBLIC_* into the JavaScript bundle
# when the frontend is BUILT (`npm run build`). Changing these values
# afterwards requires rebuilding — restarting the server is not enough.
# A stale build keeps pointing at the old backend, and every request then
# fails in the browser with "Failed to fetch". If only the API URL is set,
# the WebSocket URL is derived from it (http→ws, https→wss).
